# ─── Required ─────────────────────────────────────────────────────────────────
TS_EMAIL=your@email.com

# Your session token from the browser:
# Open ticketswap.com in Chrome (logged in) → F12 → Application → Cookies
# → https://www.ticketswap.com → find "token" → copy the Value
TS_TOKEN=paste_token_value_here

# ─── Single-event mode (ignored when events.json exists) ──────────────────────
TS_EVENT_URL=https://www.ticketswap.com/event/your-event/12345
TS_MAX_PRICE=100
TS_QUANTITY=1

# ─── Optional ─────────────────────────────────────────────────────────────────
# How often to check in milliseconds (default: 3000)
TS_POLL_INTERVAL=3000
