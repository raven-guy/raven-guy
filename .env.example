# TicketSwap account credentials
TS_EMAIL=your@email.com
TS_PASSWORD=yourpassword

# URL of the event page on TicketSwap
# e.g. https://www.ticketswap.com/event/festival-name/12345
TS_EVENT_URL=https://www.ticketswap.com/event/your-event/12345

# Maximum price you're willing to pay per ticket (in the listing currency)
TS_MAX_PRICE=100

# Number of tickets to buy
TS_QUANTITY=1

# How often to check for new tickets (milliseconds). Default: 2000 (2 seconds)
TS_POLL_INTERVAL=2000

# Run browser without a visible window (true/false). Default: true
# Set to false to watch the bot work and handle CAPTCHAs manually
HEADLESS=true
