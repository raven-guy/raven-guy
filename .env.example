# ─── Required ─────────────────────────────────────────────────────────────────
TS_EMAIL=your@email.com
# No password needed — TicketSwap sends a login code to your email

# ─── Single-event mode (ignored when events.json exists) ──────────────────────
# Copy the event URL from your browser on ticketswap.com
TS_EVENT_URL=https://www.ticketswap.com/event/your-event/12345

# Maximum price per ticket (in the listing currency)
TS_MAX_PRICE=100

# Number of tickets to buy
TS_QUANTITY=1

# ─── Multi-event mode ─────────────────────────────────────────────────────────
# For multiple events, create events.json instead (see events.example.json).
# events.json takes priority over the three vars above.

# ─── Optional ─────────────────────────────────────────────────────────────────
# How often to check for tickets in milliseconds (default: 2000)
TS_POLL_INTERVAL=2000

# Show browser window — set to false to debug or solve CAPTCHAs manually
HEADLESS=true
